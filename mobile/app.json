{
  "expo": {
    "name": "Translation App",
    "slug": "translation-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.csc10014team07.translationapp",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      [
        "expo-av",
        {
          "microphonePermission": "Allow translation app to access microphone."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow access to photos for OCR.",
          "cameraPermission": "Allow access to camera for OCR."
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "c581b7dd-9112-4374-8ffb-a38e2d813101"
      }
    },
    "owner": "kahgn"
  }
}
