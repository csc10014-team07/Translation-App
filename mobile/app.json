{
  "expo": {
    "name": "Translation App",
    "slug": "translation-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "plugins": [
      ["expo-av", { "microphonePermission": "Allow translation app to access microphone." }],
      ["expo-image-picker", { "photosPermission": "Allow access to photos for OCR.", "cameraPermission": "Allow access to camera for OCR." }]
    ]
  }
}
